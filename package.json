{
  "name": "@alex-bond/nullable",
  "version": "1.0.0",
  "description": "Immutable variable helper to handle undefined/null values and output types.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-bond/nullable-ts.git"
  },
  "scripts": {
    "start": "tsc --watch",
    "prepare": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc && prettier --list-different --write src tests"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "5.1.6"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "pre-push": "npm run test"
    }
  }
}
